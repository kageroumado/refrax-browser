# Refrax's GN args, appended after ungoogled's flags.gn and flags.macos.gn (later values win).
# mac_deployment_target stays at Chromium's default: at 15.0 or later, WebRTC's CGDisplayStream
# screen capturer fails to compile. macOS 26 is enforced by LSMinimumSystemVersion at packaging.
target_cpu = "arm64"
symbol_level = 1
enable_dsyms = true
# The chrome target builds "Refrax Chromium Host.app" (website.refrax.engine.chromium.host),
# with its framework and helpers renamed to match.
branding_file_path = "//refrax/host/BRANDING"
# The client loads into Refrax's process and must not install Chromium's allocator shim, and
# host and client share this build: both allocate through the system malloc.
use_partition_alloc_as_malloc = false
use_allocator_shim = false
enable_backup_ref_ptr_support = false
