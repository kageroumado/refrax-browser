# Development configuration on top of args.gn. One static build directory produces both the
# host app and the client that loads into Refrax, and relinks in minutes: no LTO, no PGO.
is_official_build = false
is_component_build = false
use_thin_lto = false
chrome_pgo_phase = 0
dcheck_always_on = true
symbol_level = 1
enable_dsyms = false

# The client is loaded into Refrax's process. PartitionAlloc-as-malloc replaces the default
# malloc zone from a load-time constructor while Refrax's threads run, and the setting is per
# build directory, so the whole dev build goes without it.
use_partition_alloc_as_malloc = false
use_allocator_shim = false
enable_backup_ref_ptr_support = false

# Non-official builds default to transpiling DevTools with esbuild, a binary ungoogled prunes;
# tsc, as in the release build, is in the tree.
devtools_skip_typecheck = false
# ungoogled's LLVM 23 compiles build/precompile.h as a module interface unit and fails;
# official builds never use precompiled headers either.
enable_precompiled_headers = false
