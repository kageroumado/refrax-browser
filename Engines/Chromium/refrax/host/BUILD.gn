assert(is_mac)

import("//base/allocator/partition_allocator/partition_alloc.gni")
import("//testing/test.gni")

# The host's logic that needs no browser: contract JSON, filter-list compiling, URL matching,
# secrets.
# Its own target so refrax_unittests links it without //chrome.
source_set("support") {
  sources = [
    "content_blocking_compiler.cc",
    "content_blocking_compiler.h",
    "contract_json.cc",
    "contract_json.h",
    "secrets.cc",
    "secrets.h",
    "url_matching.cc",
    "url_matching.h",
  ]
  deps = [
    "//base",
    "//components/subresource_filter/core/common",
    "//components/subresource_filter/tools/rule_parser",
    "//components/subresource_filter/tools/ruleset_converter:support",
    "//components/url_pattern_index/proto:url_pattern_index",
    "//crypto",
    "//third_party/protobuf:protobuf_lite",
    "//url",
  ]
}

# The engine host: Chromium's browser process (//chrome, no Chrome UI) serving Refrax's engine
# contract to the client over Mojo. Linked into the host app through chrome_dll
# (patches/chrome-host-content-browser-client.patch); inert unless launched with
# --refrax-bootstrap.
source_set("host") {
  sources = [
    "content_blocking.cc",
    "content_blocking.h",
    "download_delegate.cc",
    "download_delegate.h",
    "engine_connection.h",
    "engine_connection.mm",
    "engine_host_impl.mm",
    "engine_host_impl.h",
    "engine_requests.cc",
    "engine_requests.h",
    "host_content_browser_client.cc",
    "host_content_browser_client.h",
    "host_page.h",
    "host_page.mm",
    "navigation_policy.mm",
    "navigation_policy.h",
    "notifications.mm",
    "notifications.h",
    "page_dialogs.cc",
    "page_dialogs.h",
    "page_downloads.cc",
    "page_downloads.h",
    "page_scripts.cc",
    "page_scripts.h",
    "permission_prompt.cc",
    "permission_prompt.h",
    "refrax_browser_main_extra_parts.mm",
    "refrax_browser_main_extra_parts.h",
    "secret_key_provider.cc",
    "secret_key_provider.h",
    "site_settings.cc",
    "site_settings.h",
    "switches.cc",
    "switches.h",
    "world_registry.cc",
    "world_registry.h",
  ]
  deps = [
    ":support",
    "//base",
    "//chrome/browser",
    "//chrome/browser/notifications",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/js_injection/browser",
    "//components/js_injection/common:common_mojom",
    "//components/download/public/common:public",
    "//components/input",
    "//components/keyed_service/content",
    "//components/keep_alive_registry",
    "//components/os_crypt/async/browser:key_provider_interface",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//components/permissions",
    "//components/remote_cocoa/browser",
    "//components/remote_cocoa/common:mojo",
    "//components/subresource_filter/content/browser",
    "//components/subresource_filter/core/browser",
    "//components/subresource_filter/core/common",
    "//components/subresource_filter/core/mojom",
    "//components/url_pattern_index/proto:url_pattern_index",
    "//components/viz/common",
    "//content/public/browser",
    "//content/public/common",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//net",
    "//refrax/common/mojom",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/events",
    "//ui/shell_dialogs",
    "//url",
  ]
  frameworks = [ "AppKit.framework" ]

  # The client ships in the same engine bundle, so building the host (the chrome target) builds
  # it too where it can be built: a directory without the allocator shim (out/Dev). The release
  # host's directory keeps the shim, and forge builds the client in out/Release.
  if (!use_allocator_shim) {
    data_deps = [ "//refrax/client:RefraxChromium" ]
  }
}

test("refrax_unittests") {
  sources = [
    "content_blocking_compiler_unittest.cc",
    "contract_json_unittest.cc",
    "secrets_unittest.cc",
    "url_matching_unittest.cc",
  ]
  deps = [
    ":support",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/subresource_filter/core/common",
    "//components/url_pattern_index/proto:url_pattern_index",
    "//testing/gtest",
    "//third_party/protobuf:protobuf_lite",
    "//url",
  ]
}
