module refrax.mojom;

import "components/remote_cocoa/common/application.mojom";
import "mojo/public/mojom/base/values.mojom";
import "skia/public/mojom/bitmap.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";

// Refrax's engine contract (Engines/CONTRACT.md) between the client loaded into Refrax and the
// host app. Contract payloads cross as the contract's own JSON: the host translates them to and
// from Chromium, the client passes them through, and Refrax validates every one.
//
// Every interface below is associated with the EngineHost pipe, as is the client's
// remote_cocoa Application, so page calls and the NSView calls they cause stay in order.

// Implemented by the host; the client's primary remote. Closing it quits the host.
interface EngineHost {
  // The first call. `configuration` is the contract's EngineConfiguration; `application` is
  // where the host builds each page's NSViews.
  Start(string configuration,
        pending_associated_remote<remote_cocoa.mojom.Application> application)
      => (string? error);

  // `spec` is the contract's EnginePageSpec. Replies with the id the client registers its
  // container NSView under before calling Page.AttachView.
  CreatePage(string spec,
             pending_associated_receiver<Page> page,
             pending_associated_remote<PageClient> client)
      => (uint64 container_ns_view_id);

  // The contract's PolicyUpdate.
  ApplyPolicy(string update);

  // The contract's EngineProfileSpec; deletes everything stored for it.
  RemoveProfile(string profile) => ();
};

interface Page {
  // The container is registered under the id CreatePage returned: build the page's views in it.
  AttachView();

  // The container's size in points.
  SetSize(gfx.mojom.Size size);

  // The contract's PageCommand.
  PerformCommand(string command);

  // The contract's ScriptRequest; completes with a ScriptValue or an error message.
  EvaluateScript(string request) => (string? result, string? error);

  // The page's current pixels in `rect` (view points; empty for the whole view), at the
  // display's resolution. Null when the page has nothing rendered to copy.
  Snapshot(gfx.mojom.Rect rect) => (skia.mojom.BitmapN32? image);

  // Tears the page down. The reply is sent before the page's views are: the views' own
  // messages share this pipe, so every one that names the page's container arrives first.
  Close() => ();
};

interface PageClient {
  // The contract's PageEvent.
  OnEvent(string event);

  // The contract's PageRequestKind, answered once with a PageRequestAnswer.
  OnRequest(string request) => (string answer);

  // The contract's ScriptMessage, answered once with a ScriptReply.
  OnScriptMessage(string message) => (string reply);

  // A key-down the page didn't handle (ui::EventToData of its NSEvent): the client offers it
  // to Refrax's menus, which is how ⌘-shortcuts reach Refrax and the Edit menu while the page
  // has focus. Between client and host only; not part of the contract.
  RedispatchKeyEvent(array<uint8> native_event_data);
};

// Runs the contract's evaluateScript in one frame, in any of Refrax's worlds. Implemented in
// the renderer by //refrax/renderer; content's browser-side script APIs cap world ids at
// content's own and never await promises.
interface FrameScripts {
  // `world_id` 0 is the page's world. The result is the script's completion value (a promise
  // is awaited; undefined is null) as JSON-compatible data, or `error` when it threw, its
  // promise rejected, or its value can't be represented as JSON.
  Evaluate(string source, int32 world_id, bool user_gesture)
      => (mojo_base.mojom.Value? result, string? error);
};
