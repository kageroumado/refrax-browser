#!/bin/bash
# forge — builds the Chromium engine. Plan: Docs/plans/engine-forge.md.
#
#   eval "$(Scripts/forge/forge env)"
#   forge doctor | bootstrap | fetch | prepare | status                  (build host)
#   forge gen [release|dev] | build [release|dev] [targets…]        (build host)
#   forge package <release|dev> <name>                            (build host)
#   forge sign <name> | notarize <name> | install <name> [debug]  (the Mac Refrax runs on)
#
# FORGE is the workspace (default: the Ugreen SSD on the Mac Studio). A host with the forge
# elsewhere exports FORGE before running, e.g. FORGE=~/Forge/chromium on the MacBook.
#
# The source and toolchains come through ungoogled-chromium-macos at the tag pinned in
# Scripts/forge/ungoogled-macos.txt: a shallow git clone of Chromium (which carries the PGO
# profile the official build uses), ungoogled's LLVM, Rust nightly and Node, ungoogled's
# pruning, patches and domain substitution. Refrax's GN args are appended to ungoogled's.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
FORGE="${FORGE:-/Volumes/Ugreen/Projects/refrax/engines/chromium}"
UNGOOGLED_TAG="$(tr -d '[:space:]' <"$SCRIPT_DIR/ungoogled-macos.txt")"
REFRAX_ARGS="$REPO_ROOT/Engines/Chromium/args.gn"
PATCHES="$REPO_ROOT/Engines/Chromium/patches"
# //refrax: the engine host, the client and their shared Mojo interface.
REFRAX_SOURCES="$REPO_ROOT/Engines/Chromium/refrax"

UNGOOGLED="$FORGE/ungoogled"
MAIN_REPO="$UNGOOGLED/ungoogled-chromium"
SRC="$FORGE/src"
LOGS="$FORGE/logs"
PYTHON="/opt/homebrew/bin/python3.13"   # depot_tools rejects 3.14
MIN_FREE_GB="${FORGE_MIN_FREE_GB:-150}"
# chrome is the host app ("Refrax Chromium Host.app"); it builds the client as a data dep.
TARGETS=(chrome)

# The macOS SDK Chromium pins (mac_sdk_official_version), from Xcode or the Command Line Tools.
# A newer SDK is unusable: the 27 SDK's .tbd stubs name targets ungoogled's LLVM cannot parse.
mac_sdk() {
    local version dir
    version=$(sed -n 's/^ *mac_sdk_official_version = "\(.*\)"/\1/p' \
        "$SRC/build/config/mac/mac_sdk.gni" 2>/dev/null)
    [[ -n "$version" ]] || return 1
    for dir in "$(xcode-select -p)/Platforms/MacOSX.platform/Developer/SDKs" \
        /Library/Developer/CommandLineTools/SDKs; do
        [[ -d "$dir/MacOSX$version.sdk" ]] && { echo "$dir/MacOSX$version.sdk"; return; }
    done
    return 1
}

log() { printf '[forge %s] %s\n' "$(date '+%H:%M:%S')" "$*" >&2; }
die() { log "error: $*"; exit 1; }

cmd_env() {
    cat <<EOF
export FORGE="$FORGE"
export PATH="$FORGE/bin:$SCRIPT_DIR:/opt/homebrew/bin:\$PATH"
export DEPOT_TOOLS_UPDATE=0
export DEPOT_TOOLS_METRICS=0
export NO_COLOR=1
EOF
    local sdk
    sdk=$(mac_sdk) && echo "export SDKROOT=\"$sdk\""
    return 0
}

# One line per check; exit 1 when any fails.
cmd_doctor() {
    local failed=0
    check() {
        local label="$1"; shift
        if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"
        else printf '  FAIL  %s\n' "$label"; failed=1; fi
    }
    local free_gb
    mkdir -p "$FORGE"
    free_gb=$(df -g "$FORGE" | awk 'NR==2 {print $4}')
    check "arm64 host" test "$(uname -m)" = arm64
    check "macOS 26 or later" test "$(sw_vers -productVersion | cut -d. -f1)" -ge 26
    check "≥ ${MIN_FREE_GB} GB free at $FORGE (${free_gb} GB)" test "$free_gb" -ge "$MIN_FREE_GB"
    check "full Xcode selected" bash -c 'xcode-select -p | grep -q "\.app/Contents/Developer"'
    check "macOS SDK" xcrun --sdk macosx --show-sdk-path
    check "Metal toolchain" xcrun metal --version
    check "python3.13 with httplib2" "$PYTHON" -c 'import httplib2, socks'
    local tool
    for tool in git ninja go greadlink node xz rsync; do
        check "$tool" command -v "$tool"
    done
    check "Refrax GN args" test -f "$REFRAX_ARGS"
    if [[ -f "$SRC/build/config/mac/mac_sdk.gni" ]]; then
        check "macOS SDK Chromium pins ($(mac_sdk || echo missing))" mac_sdk
    fi
    check "no other forge run" bash -c "test ! -d '$FORGE/.lock' || ! kill -0 \$(cat '$FORGE/.lock/pid' 2>/dev/null) 2>/dev/null"
    return "$failed"
}

# Serializes runs; a lock left by a dead process is taken over.
acquire_lock() {
    if ! mkdir "$FORGE/.lock" 2>/dev/null; then
        local holder
        holder=$(cat "$FORGE/.lock/pid" 2>/dev/null || true)
        if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
            die "forge run $holder holds $FORGE/.lock"
        fi
    fi
    mkdir -p "$FORGE/.lock"
    echo $$ >"$FORGE/.lock/pid"
    trap 'trash "$FORGE/.lock" 2>/dev/null || mv "$FORGE/.lock" "$FORGE/.lock.stale.$$"' EXIT
}

stamp() { echo "$SRC/.forge-$1"; }

cmd_bootstrap() {
    mkdir -p "$FORGE"/{bin,downloads,logs,artifacts}
    ln -sf "$PYTHON" "$FORGE/bin/python3"
    if [[ ! -d "$UNGOOGLED/.git" ]]; then
        log "cloning ungoogled-chromium-macos $UNGOOGLED_TAG"
        git clone -q -c advice.detachedHead=false --recurse-submodules -b "$UNGOOGLED_TAG" \
            https://github.com/ungoogled-software/ungoogled-chromium-macos.git "$UNGOOGLED"
    else
        git -C "$UNGOOGLED" fetch -q --tags origin
        git -C "$UNGOOGLED" -c advice.detachedHead=false checkout -q "$UNGOOGLED_TAG"
        git -C "$UNGOOGLED" submodule update -q --init --recursive
    fi
    # ungoogled's scripts hard-code build/src and build/download_cache under their checkout.
    # The tree lives there and $FORGE/src points at it; git cannot clone through a symlink.
    mkdir -p "$UNGOOGLED/build"
    [[ -L "$UNGOOGLED/build/src" ]] && mv "$UNGOOGLED/build/src" "$FORGE/.src-link.$$" && trash "$FORGE/.src-link.$$"
    ln -sfn "$UNGOOGLED/build/src" "$SRC"
    ln -sfn "$FORGE/downloads" "$UNGOOGLED/build/download_cache"
    log "ungoogled-chromium-macos $(git -C "$UNGOOGLED" describe --tags), Chromium $(chromium_version)"
}

chromium_version() { cat "$MAIN_REPO/chromium_version.txt"; }

cmd_fetch() {
    [[ -d "$UNGOOGLED/.git" ]] || die "run forge bootstrap first"
    log "fetching Chromium $(chromium_version) (shallow clone with PGO profile)"
    "$PYTHON" "$UNGOOGLED/retrieve_and_unpack_resource.py" -g arm64
    touch "$(stamp "fetched-$(chromium_version)")"
}

# Each step stamps itself: pruning, patching and substitution cannot run twice on one tree.
prepare_step() {
    local name="$1"; shift
    local done_stamp
    done_stamp="$(stamp "prepare-$name-$(chromium_version)")"
    if [[ -f "$done_stamp" ]]; then
        log "$name: done"
        return
    fi
    log "$name"
    "$@"
    touch "$done_stamp"
}

step_gn() { (cd "$SRC" && "$PYTHON" tools/gn/bootstrap/bootstrap.py -o out/gn --skip-generate-buildfiles); }
step_bindgen() { (cd "$SRC" && "$PYTHON" tools/rust/build_bindgen.py --skip-test); }

# Refrax's edits to upstream files (Engines/Chromium/patches/README.md says why each exists).
step_refrax_patches() {
    local patch
    for patch in "$PATCHES"/*.patch; do
        log "  $(basename "$patch")"
        patch -p1 --forward --quiet -d "$SRC" <"$patch"
    done
}

cmd_prepare() {
    local version
    version=$(chromium_version)
    [[ -f "$(stamp "fetched-$version")" ]] || die "run forge fetch first"
    prepare_step prune "$PYTHON" "$MAIN_REPO/utils/prune_binaries.py" "$SRC" "$MAIN_REPO/pruning.list"
    prepare_step patches "$PYTHON" "$MAIN_REPO/utils/patches.py" apply "$SRC" \
        "$MAIN_REPO/patches" "$UNGOOGLED/patches"
    prepare_step domains "$PYTHON" "$MAIN_REPO/utils/domain_substitution.py" apply \
        -r "$MAIN_REPO/domain_regex.list" -f "$MAIN_REPO/domain_substitution.list" "$SRC"
    prepare_step refrax step_refrax_patches
    prepare_step toolchains "$PYTHON" "$UNGOOGLED/retrieve_and_unpack_resource.py" -p arm64
    mkdir -p "$SRC/out"
    prepare_step gn step_gn
    prepare_step bindgen step_bindgen
    touch "$(stamp "prepared-$version")"
}

# release: the shipped configuration (official, ThinLTO, PGO). dev: a static build for
# patch development, fast to relink; Engines/Chromium/args.dev.gn goes on top.
out_name() {
    case "${1:-release}" in
        release) echo Release ;;
        dev) echo Dev ;;
        *) die "unknown configuration: $1 (release or dev)" ;;
    esac
}

cmd_gen() {
    [[ -f "$(stamp "prepared-$(chromium_version)")" ]] || die "run forge prepare first"
    local config="${1:-release}" name out sdk
    name=$(out_name "$config")
    out="$SRC/out/$name"
    ln -sfn "$REFRAX_SOURCES" "$SRC/refrax"
    mkdir -p "$out/sdk/forge"
    # GN takes SDK inputs only from inside the build directory, as Chromium's own
    # sdk/xcode_links symlink does for Xcode's SDK.
    sdk=$(mac_sdk) || die "no macOS SDK matching Chromium's mac_sdk_official_version"
    ln -sfn "$sdk" "$out/sdk/forge/$(basename "$sdk")"
    {
        echo "# Generated by forge ($config): ungoogled flags.gn + flags.macos.gn + Engines/Chromium/args*.gn"
        cat "$MAIN_REPO/flags.gn" "$UNGOOGLED/flags.macos.gn"
        cat "$REFRAX_ARGS"
        [[ "$config" == dev ]] && cat "$REPO_ROOT/Engines/Chromium/args.dev.gn"
        echo "mac_sdk_path = \"//out/$name/sdk/forge/$(basename "$sdk")\""
    } >"$out/args.gn"
    (cd "$SRC" && out/gn gen "out/$name" --fail-on-unused-args)
}

cmd_build() {
    local config="${1:-release}" name out
    name=$(out_name "$config")
    out="$SRC/out/$name"
    shift || true
    local targets=("${TARGETS[@]}")
    (($#)) && targets=("$@")
    [[ -f "$out/build.ninja" ]] || die "run forge gen $config first"
    local started ended
    started=$(date +%s)
    log "ninja -C out/$name ${targets[*]} on $(sysctl -n hw.ncpu) cores"
    # FORGE_NINJA_FLAGS: e.g. "-k 0" to keep compiling past failures and see them all at once.
    # shellcheck disable=SC2086
    ninja -C "$out" ${FORGE_NINJA_FLAGS:-} "${targets[@]}"
    ended=$(date +%s)
    printf '%s\t%s\t%s\t%s\t%s\t%ss\n' "$(date -u +%FT%TZ)" "$(hostname -s)" "$(chromium_version)" \
        "$config" "${targets[*]}" "$((ended - started))" >>"$LOGS/build-times.tsv"
    log "built out/$name ${targets[*]} in $(((ended - started) / 60)) min"
}

# Everything one engine build produced lives in artifacts/<name>/.
artifact_dir() {
    [[ -n "${1:-}" ]] || die "usage: forge $2 <name>, e.g. 152.0.7977.82-r1"
    echo "$FORGE/artifacts/$1"
}

MINIMUM_SYSTEM_VERSION="26.0"
TEAM_ID="52K336H235"
NOTARY_PROFILE="${FORGE_NOTARY_PROFILE:-kagerou-notary}"
ENTITLEMENTS="$REPO_ROOT/Engines/Chromium/entitlements"
ENGINE_NAME="Refrax Chromium.engine"
ENGINE_ID="website.refrax.engine.chromium"
HOST_NAME="Refrax Chromium Host"

engine_path() { echo "$(artifact_dir "$1" "$2")/$ENGINE_NAME"; }

# Assembles artifacts/<name>/Refrax Chromium.engine from a build: the client as the bundle's
# executable, the host app in Contents/Helpers (nested code, sealed by the bundle's signature),
# and the contract's Info.plist. Runs on the build host.
#   forge package <release|dev> <name>
cmd_package() {
    local config="${1:-}" name="${2:-}" out engine host
    [[ -n "$config" && -n "$name" ]] || die "usage: forge package <release|dev> <name>"
    out="$SRC/out/$(out_name "$config")"
    [[ -d "$out/$HOST_NAME.app" && -f "$out/RefraxChromium" ]] ||
        die "no engine build in $out (forge build $config)"
    engine=$(engine_path "$name" package)
    host="$engine/Contents/Helpers/$HOST_NAME.app"
    mkdir -p "$engine/Contents/MacOS" "$engine/Contents/Helpers"
    rsync -a --delete "$out/$HOST_NAME.app/" "$host/"
    cp "$out/RefraxChromium" "$engine/Contents/MacOS/RefraxChromium"

    local version revision bundle_version
    version=$(chromium_version)
    revision=$([[ "$name" =~ -r([0-9]+)$ ]] && echo "${BASH_REMATCH[1]}" || echo 0)
    bundle_version="$(cut -d. -f3,4 <<<"$version").$revision"
    sed -e "s/@CHROMIUM_VERSION@/$version/g" -e "s/@BUNDLE_VERSION@/$bundle_version/g" \
        "$REFRAX_SOURCES/client/Info.plist" >"$engine/Contents/Info.plist"
    plutil -insert RFXEngineBuild -string "$name" "$engine/Contents/Info.plist"

    # Nothing LaunchServices would route to the host; its state lives where the client points
    # --user-data-dir. LSUIElement must stay unset: Chromium reads it as "this is a helper
    # process" (base::apple::IsBackgroundOnlyProcess) and looks for its framework in the wrong
    # place. The host hides from the Dock at runtime instead (RefraxBrowserMainExtraParts).
    local plist="$host/Contents/Info.plist" key
    plutil -replace CrProductDirName -string "$HOST_NAME" "$plist"
    for key in CFBundleURLTypes CFBundleDocumentTypes NSUserActivityTypes OSAScriptingDefinition; do
        plutil -remove "$key" "$plist" 2>/dev/null || true
    done
    while IFS= read -r -d '' plist; do
        plutil -replace LSMinimumSystemVersion -string "$MINIMUM_SYSTEM_VERSION" "$plist"
    done < <(find "$engine" -name Info.plist -path '*/Contents/Info.plist' -print0)

    local file archs bad=0
    while IFS= read -r -d '' file; do
        archs=$(lipo -archs "$file" 2>/dev/null) || continue
        [[ "$archs" == arm64 ]] || { log "not arm64-only ($archs): $file"; bad=1; }
    done < <(find "$engine" -type f -print0)
    ((bad == 0)) || die "non-arm64 Mach-O in $engine"
    cp "$out/args.gn" "$(artifact_dir "$name" package)/args.gn"
    log "packaged $engine ($(du -sh "$engine" | cut -f1))"
}

# The signing identity's SHA-1: FORGE_SIGN_IDENTITY when set (development: the identity that
# signs a debug Refrax, which loads only engines from its own team), else the team's Developer ID.
signing_identity() {
    if [[ -n "${FORGE_SIGN_IDENTITY:-}" ]]; then
        echo "$FORGE_SIGN_IDENTITY"
        return
    fi
    security find-identity -v -p codesigning |
        grep "Developer ID Application: .*($TEAM_ID)" | awk '{print $2; exit}'
}

# Inside-out signing with the hardened runtime: the host app as ungoogled-chromium-macos signs
# Chromium.app (per-helper entitlements), then the client, then the engine bundle.
cmd_sign() {
    local engine identity host framework helpers
    engine=$(engine_path "${1:-}" sign)
    [[ -d "$engine" ]] || die "run forge package first"
    identity=$(signing_identity)
    [[ -n "$identity" ]] || die "no signing identity (set FORGE_SIGN_IDENTITY or install a Developer ID)"
    host="$engine/Contents/Helpers/$HOST_NAME.app"
    framework="$host/Contents/Frameworks/$HOST_NAME Framework.framework"
    helpers="$framework/Helpers"
    local timestamp=--timestamp
    [[ -n "${FORGE_SIGN_IDENTITY:-}" ]] && timestamp=--timestamp=none
    sign() { codesign --sign "$identity" --force "$timestamp" "$@"; }

    xattr -cr "$engine"
    local tool
    for tool in chrome_crashpad_handler app_mode_loader web_app_shortcut_copier; do
        [[ -e "$helpers/$tool" ]] &&
            sign --identifier "$tool" --options restrict,library,runtime,kill "$helpers/$tool"
    done
    sign --options restrict,library,runtime,kill "$helpers/$HOST_NAME Helper.app"
    sign --options restrict,library,runtime,kill "$helpers/$HOST_NAME Helper (Alerts).app"
    sign --options restrict,kill,runtime \
        --entitlements "$ENTITLEMENTS/helper-renderer-entitlements.plist" \
        "$helpers/$HOST_NAME Helper (Renderer).app"
    sign --options restrict,kill,runtime \
        --entitlements "$ENTITLEMENTS/helper-gpu-entitlements.plist" \
        "$helpers/$HOST_NAME Helper (GPU).app"
    local dylib
    for dylib in "$framework/Libraries"/*.dylib; do
        [[ -e "$dylib" ]] && sign --identifier "$(basename "$dylib" .dylib)" "$dylib"
    done
    sign "$framework"
    sign --options restrict,library,runtime,kill \
        --entitlements "$ENTITLEMENTS/app-entitlements.plist" "$host"
    # The client runs inside Refrax, under Refrax's own runtime and entitlements.
    sign --options runtime "$engine/Contents/MacOS/RefraxChromium"
    sign "$engine"

    codesign --verify --deep --strict "$engine"
    touch "$(artifact_dir "$1" sign)/.signed"
    log "signed with $identity"
}

cmd_notarize() {
    local dir engine zip
    dir=$(artifact_dir "${1:-}" notarize)
    engine="$dir/$ENGINE_NAME"
    [[ -f "$dir/.signed" ]] || die "run forge sign $1 first"
    zip="$dir/notarize.zip"
    ditto -c -k --keepParent "$engine" "$zip"
    xcrun notarytool submit "$zip" --keychain-profile "$NOTARY_PROFILE" --wait --timeout 30m \
        --output-format json | tee "$dir/notary.json"
    local status
    status=$(plutil -extract status raw -o - "$dir/notary.json" 2>/dev/null || true)
    if [[ "$status" != Accepted ]]; then
        local id
        id=$(plutil -extract id raw -o - "$dir/notary.json" 2>/dev/null || true)
        [[ -n "$id" ]] && xcrun notarytool log "$id" --keychain-profile "$NOTARY_PROFILE" "$dir/notary-log.json"
        die "notarization $status; log in $dir/notary-log.json"
    fi
    # A bundle can't carry a ticket; the host app inside it can.
    xcrun stapler staple "$engine/Contents/Helpers/$HOST_NAME.app"
    trash "$zip"
    touch "$dir/.notarized"
}

# Installs a signed engine where a Refrax build discovers it, next to (never over) a running
# one: a mapped binary overwritten in place is killed with Code Signature Invalid.
#   forge install <name> [debug|release]
cmd_install() {
    local name="${1:-}" flavor="${2:-debug}" engine app_id engines staging
    engine=$(engine_path "$name" install)
    [[ -f "$(artifact_dir "$name" install)/.signed" ]] || die "run forge sign $name first"
    app_id=website.refrax.browser
    [[ "$flavor" == debug ]] && app_id=website.refrax.browser.debug
    engines="$HOME/Library/Application Support/$app_id/Engines/$ENGINE_ID"
    staging="$engines/$ENGINE_NAME.staging"
    mkdir -p "$engines"
    [[ -e "$staging" ]] && trash "$staging"
    ditto "$engine" "$staging"
    # One bundle per engine id: Refrax keeps whichever it happens to read last.
    local installed
    for installed in "$engines"/*.engine; do
        [[ -e "$installed" ]] && trash "$installed"
    done
    mv "$staging" "$engines/$ENGINE_NAME"
    log "installed $name for $app_id"
}

# Drives an engine through RFXEngine.h the way Refrax does, without Refrax: loads it, opens
# one page in a window, prints every event as a JSON line (Engines/Chromium/harness/main.m).
#   forge harness <name> <url> [--eval JS] [--seconds N]
cmd_harness() {
    local name="${1:-}" url="${2:-}" engine
    [[ -n "$name" && -n "$url" ]] || die "usage: forge harness <name> <url> [--eval JS] [--seconds N]"
    shift 2
    engine=$(engine_path "$name" harness)
    [[ -d "$engine" ]] || die "no engine at $engine"
    mkdir -p "$FORGE/bin"
    clang -fobjc-arc -O1 -Wall -I "$REPO_ROOT/Engines/SDK" "$REPO_ROOT/Engines/Chromium/harness/main.m" \
        -framework AppKit -o "$FORGE/bin/engine-harness"
    "$FORGE/bin/engine-harness" "$engine" "$url" \
        --storage "$(artifact_dir "$name" harness)/harness-storage" "$@"
}

cmd_status() {
    printf 'FORGE      %s\n' "$FORGE"
    printf 'ungoogled  %s\n' "$(git -C "$UNGOOGLED" describe --tags 2>/dev/null || echo 'not bootstrapped')"
    printf 'stamps     %s\n' "$(cd "$SRC" 2>/dev/null && ls -d .forge-* 2>/dev/null | tr '\n' ' ')"
    printf 'free       %s GB\n' "$(df -g "$FORGE" | awk 'NR==2 {print $4}')"
    [[ -f "$LOGS/build-times.tsv" ]] && { echo 'builds'; tail -5 "$LOGS/build-times.tsv"; }
    return 0
}

main() {
    local command="${1:-}"
    [[ -n "$command" ]] || die "usage: forge env|doctor|bootstrap|fetch|prepare|gen|build|package|sign|notarize|install|harness|status"
    shift
    case "$command" in
        env) cmd_env ;;
        doctor) cmd_doctor ;;
        status) cmd_status ;;
        harness)
            eval "$(cmd_env)"
            cmd_harness "$@"
            ;;
        bootstrap|fetch|prepare|gen|build|package|sign|notarize|install)
            eval "$(cmd_env)"
            # Only a source checkout or a build needs the full working space.
            [[ "$command" == package ]] && MIN_FREE_GB="${FORGE_MIN_FREE_GB:-20}"
            if [[ "$command" != sign && "$command" != notarize && "$command" != install ]]; then
                cmd_doctor >/dev/null || { cmd_doctor; die "doctor failed"; }
            fi
            mkdir -p "$LOGS"
            acquire_lock
            local logfile
            logfile="$LOGS/$(date +%Y%m%d-%H%M%S)-$command.log"
            log "log: $logfile"
            "cmd_$command" "$@" 2>&1 | tee "$logfile"
            ;;
        *) die "unknown command: $command" ;;
    esac
}

main "$@"
